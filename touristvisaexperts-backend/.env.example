# Environment Mode & Port
NODE_ENV=development
PORT=5000

# Database (In production, use MongoDB Atlas replica set URI)
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/finalvisa?retryWrites=true&w=majority

# JWT Security
JWT_SECRET=your_super_secret_key_change_this_in_production
JWT_EXPIRE=7d

# CORS & Domain Settings
CORS_ORIGIN=http://localhost:5173
MARKETING_URL=http://localhost:5174
CLIENT_URL=http://localhost:5173
SITE_URL=http://localhost:5174
COOKIE_DOMAIN=

# Razorpay Payment Gateway & Webhook (Mandatory for Payments & Provisioning)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Cloud Object Storage (Cloudflare R2 or AWS S3 - Mandatory for Production Passports/Docs)
# Leave empty for local filesystem uploads in dev
S3_BUCKET=tourist-visa-documents
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=auto
# For Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=

# Local File Upload Fallback (Development only)
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# Email SMTP Credentials (Nodemailer)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=support@touristvisaexperts.com
SMTP_PASS=your_email_password
SMTP_FROM="Tourist Visa Experts" <support@touristvisaexperts.com>

# Notifications & Support
ADMIN_EMAIL=admin@touristvisaexperts.com
ADMIN_WHATSAPP=+919876543210
CALENDLY_URL=https://calendly.com/your-team

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=255901629118-q32ejsi969n0haqdc2quc0thru3dikce.apps.googleusercontent.com

# Stripe (Optional - International Currency)
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
